{
  // Typechecks the specs and the test helpers (the other tsconfigs exclude them; Vitest strips types without checking them).
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["schematics/**/*.ts"],
  "exclude": ["node_modules", "dist", "schematics/**/files/**"]
}
