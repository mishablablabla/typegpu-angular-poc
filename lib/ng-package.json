{
  "$schema": "./node_modules/ng-packagr/ng-package.schema.json",
  "dest": "dist",
  "allowedNonPeerDependencies": [
    "jsonc-parser"
  ],
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "input": "tools",
      "glob": "**/*",
      "output": "tools"
    },
    {
      "input": "builders",
      "glob": "**/*",
      "output": "builders"
    },
    {
      "input": ".",
      "glob": "builders.json",
      "output": "."
    }
  ]
}
