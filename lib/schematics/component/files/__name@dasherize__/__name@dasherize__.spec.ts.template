import { ErrorHandler<% if (zoneless) { %>, provideZonelessChangeDetection<% } %> } from '@angular/core';
import { TestBed } from '@angular/core/testing';
import { provideTypeGpu } from '<%= packageName %>';
import { createFakeTypeGpu, installManualAnimationFrames } from '<%= packageName %>/testing';
import { <%= classifiedName %> } from './<%= dasherize(name) %>';

describe('<%= classifiedName %>', () => {
  it('draws once the GPU is ready and releases its buffers when destroyed', async () => {
    const fake = createFakeTypeGpu();
    let draws = 0;
    // The fake root has no pipelines: give it the one call the component makes. The shader itself is only
    // compiled on a real GPU (see the browser check in the docs), not in unit tests.
    Object.assign(fake.root, {
      createRenderPipeline: () => ({ withColorAttachment: () => ({ draw: () => draws++ }) }),
    });
    const frames = installManualAnimationFrames();
    try {
      TestBed.configureTestingModule({ providers: [<% if (zoneless) { %>provideZonelessChangeDetection(), <% } %>provideTypeGpu({ root: fake.root })] });
      const fixture = TestBed.createComponent(<%= classifiedName %>);
      fixture.detectChanges(); // zone-based test beds do not run change detection on their own
      await fixture.whenStable();
      fixture.detectChanges(); // second pass: the scene is created behind *tgpuReady
      frames.flush();

      expect(fixture.nativeElement.querySelector('canvas')).not.toBeNull();
      expect(draws).toBe(1);
      expect(fake.liveResources()).toBe(2); // time + tint

      fixture.destroy();
      expect(fake.liveResources()).toBe(0);
    } finally {
      frames.restore();
    }
  });

  it('offers a retry when the GPU cannot be initialised', async () => {
    // A failing factory behaves the same in jsdom and in a real browser, with or without WebGPU.
    TestBed.configureTestingModule({
      providers: [
<% if (zoneless) { %>        provideZonelessChangeDetection(),
<% } %>        provideTypeGpu({ createRoot: () => Promise.reject(new Error('no adapter')) }),
        { provide: ErrorHandler, useValue: { handleError: () => undefined } },
      ],
    });
    const fixture = TestBed.createComponent(<%= classifiedName %>);
    fixture.detectChanges();
    // Wait for what is asserted, not for `whenStable()`: under zone.js (Angular 21/22 projects created with `--no-zoneless`) it can return
    // before the rejected factory has updated the component, which made this spec fail right after `ng generate`.
    for (let attempt = 0; attempt < 50 && !fixture.nativeElement.textContent.includes('GPU initialisation failed'); attempt++) {
      await new Promise((resolve) => setTimeout(resolve));
      fixture.detectChanges();
    }
    expect(fixture.nativeElement.textContent).toContain('GPU initialisation failed');
    expect(fixture.nativeElement.querySelector('button')?.textContent).toContain('Retry');
  });
});
